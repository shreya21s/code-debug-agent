# Google Gemini API configuration
# Either GEMINI_API_KEY or GOOGLE_API_KEY can be used by langchain-google-genai
GOOGLE_API_KEY=your-gemini-api-key-here
MODEL_NAME=gemini-1.5-flash

# Base workspace path where agent operations are permitted (must be absolute or relative to run command)
WORKSPACE_ROOT=./examples/sample_project

# Port numbers for A2A and MCP servers
A2A_RESEARCH_PORT=8001
A2A_REVIEWER_PORT=8002
MCP_SERVER_PORT=8003

# Logging configurations
LOG_LEVEL=INFO
